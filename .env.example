# Optional: connect Sanity CMS (site works without these)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production

# Contact form → Google Sheet + email (see docs/google-contact-apps-script.js)
GOOGLE_SCRIPT_URL=
# Optional shared secret (must match SECRET in the Apps Script)
# GOOGLE_SCRIPT_SECRET=

# Live site URL (no trailing slash). Used for sitemap, canonical, share images.
NEXT_PUBLIC_SITE_URL=https://bumpnrungc.com

# Google Analytics 4 (production only). Example: G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=
